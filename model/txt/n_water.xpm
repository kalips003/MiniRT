"%@+ +@+%+@+@+%% @%+%+ + + +%% + +%% % +  %%  + % +%+ + +%+%+% %++@% %+++%+ +% %+ + +% +%+ + +  +%+  %+    ++@++++  + %+ +++ +  % ++++  ++++ + + ++  ++++  ++  +++  +O+O+O  + + + O +++++ +OO+OO  + ++++OO  +O++  ++++ +O O OO O++ + + ++O  + +++ + ++++  +++ + ++%+++  ++ +  +% %++++++++++ %+%+++% ++%+% %+%+++ +%+%++@%@%++%@++%+@%++%+@%+%++%+%%+%+% +@+%%+%+%%%+%% %%+% % %+ % %%+%%+%%%+%%++@ %+%@%+%%+% +%% % %%+%%%+% % % %+@%@+%%+% +%%  %%+ %@% %+%% ++ % % ++%% %+ + %+% %+%+ %@@%+ +  + +++ ++++ %@+++ + %++ ++++ %++ + +++ + ++ + ++ ++++ ++ + +++ ++++  ++++ ++ + +++ + ++ + +++++ ++ +++ ++ +++ +  ++ +++ +++ + +++ ++ +    + ++ ++ +  + + + ++ + + +++ O ++ +O++ + +++ + +O +++O++++ +O+  O++ OO++++O+++O O +++O+ ++ +++++O++++++++++++++++++++++++++++++++%+++++*%++++*++*+**+*++*++%+%++*%+*++**++*+***:+%**++::++%**:*:+:+**+*::*:**************+****==O+=+**=O*+O=**=:=O*=+***++O=*=*==+=+O*+*=O+*O=+=++=O*=+OOO*=**==**==:++O*=*=**+=************:**+****:*:******:++:+*%*+::++%****:+*:+:+%:+***+*:***:+**++*%*:+%*+*+:+:+*+%+%+%+%:+:+++:++*+*+*++%*%+++++%+++%++++++%+++++++%+%%+%+++%+++%+%%+++ ++%%+ %%++%%%+%%++  ++ +%+%  %++@%%+++ %%+ ++%+% +@%+ %@@ ++++@+%++ % ++++++++++%+@+@+ +% + ++ ++++  ++++ +++ +++++++ +++++  ++ +++O+ +++++O OO+++O++++++++++++++++++++++*+*+*++*+**+*:*+::+****:**:***:*:*:*<*::-:**:::*:*:;:*:<:**:<:*:*:*<*:**::;:*;:*:*<*;:**<*::;<**;;**;*;;*;*;**;*;*******-*;-**-*:=:===*+======O===*=++=*O==O=========O:=:=OOO===$:=O:==OO=O:O=OO=*=O++O=+O+++O+++OO++**+++**+*O++++++++*++++++:+%++ $$+$$O%O$$$+%++%+%+%@+++@+%@@%%%+@%@@%+ %%+#%###########$##################@@@@@$@##@##########@###@######@%@ %@@@@@@@@% @ @@$$@%@ @@%%+% @ @%  +@@   % + ++ ++% +  %+  ++ + +  + + O+ +O+ O  +O+ ++ O + + +++++ OO++OOOO+++O+++  +O O+++O++OO+O+O+++ + +++++++ +++++++++++++++++++*%+%%++%+++++%+%%*%+%*+++*%:*%+**:++:*:***%+**+%:%*:**:::%**::%*:*:%::+:**::**:**:*:::*:*:*<<:**:***::***:*<*;*<*;*<*:*:;:<***:**:<*<:*;<*<**;*******:****<:*<*:***:*:*::**::**:*+:++:+::*:+:+:+:+:%%+***%+:%*:+%+*%+:+**+*+%+*++++++%%