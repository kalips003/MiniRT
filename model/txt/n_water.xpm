"+++%+% + %% + +%+%  +%% %%+ + %%  +%+ %%+  +%% +%+  %@%+  % @+   %@+  %@ +% %+ +% %+ ++ % +%@+% + %+ +%++%+ %  + %+@+ ++% + +++ ++  ++++  +++ ++ ++++  ++O+ +O+  O++  +  ++O +O+ ++O  O O+ ++ + O+ O OO ++O+  +O+OO O+ +++ +++  ++O++ O ++O+++ ++++++ +++++ ++%+++ ++++++%++%+++ ++% ++% +%+++ +%+%+% ++%+ ++%@+%++%@++%+++%%+%+%++%+% +%++% %% %+ %+%+%%+% %+ %+ +%%+%+ %+%+%+%%+%+%@+@++ %+% %%+%+% +%@%@++% %+%+%% % % % %+%+%+%@++%  %++% + %+ +%+% %@+ %+% %@++%@+ +% +%% + %+++ % +++ % +%+% + %+% +++ ++ + %++ + + % ++  %+ + +%+ ++ ++% ++  ++ +++ + +++  ++++  ++ +++ + +++ ++ +++ + +++ ++ + +++  +++ ++++  +++ ++++% +++ ++++++++ +++++++++++ +++ ++++ + O+++  O+ ++O+O+ O+O+ ++OO + OOO+  +O+O O + +O +O O +++O+O + O+O++ O++  +O+ +++++ +++++ ++++++ +++%+++++++++%+++%+*+%++%++%+%%+%**++:*++:+%+:%+:*%*+%+:+*%+:++****%++:**+:+:**********:****;****=**++**++:=+=**=***O*=**=*OO+===+%+O+=+O*=+==O+O==+OO+===*=*O=**=*O*O+*+%++==***+:+=+*+***************+:**+*+:+*%:+:++:**+*:++***%+:+*%+*%**++:+%+:+*%+%+%+:*:%*+*+*+*%*+%+*%:+**+++%+++%+%++%+%+%+%++++++%+%+++%++%+%+++%+%+%+++++++++%++ %%++++@%%+%+ +%+++%+ +++%+%+%+%%%++ %++%@% + %@% + +%%+  %+% +% ++%+%  +% + @% +%   %  %@ + +@++@+ ++++ ++  ++++  +++ ++  ++ ++++  +O+++O+ ++ ++O  +++++++++++++++++++++++++*++*++*+*+*%**+:+***++*****:*:****::***:***:*:***:*:***<:*:**<:*;:***::;<*:*:<;:**:;*:;**;::*;<*;;***;;**;;*;**;*;***-*-;-;*-;***-**-*==+=*=*=*=*=+*=::==O======O==*+==O$=O==OOO=O==O$O==OO=OO=$=O=O=O+=OO+==O++===++=+=+*+O+==++++*+*=*+++*+*+++++++$+$+++%O+++$$O+%O+ %%@+@+++%@%@+ %++@@%% %+ %%  %#############$####$$############@%%@$@#####@##############@#@@##@@@@ %@@%@@%@ %%$@@@$@@%%   @@+  %@@+ %@% + + + +% + + +++ + +% +++ ++ ++ +++ O ++O+ + OO+ ++OO  O OO++ O + +OO O+ OO+O+O++ OO + ++ ++++ +O+O+++ +++++++++ ++++%++%++++%++++++*+%+%*++*++*+*%+%:%+*++:*%%*%*%+%+%%:*%:*:***%:%:++::%:*:*::**+::::::+::*::*:*:*:*:*:*:*:**:<:*;*:<**::*:*:**:;*;***:*:<<**;*:**:*:**::*:**:<:*<*:<:***:**:<:<**:**+:*:*:*::*::*:++:+:+:+:+:***:+:**%+:++**:+**%*%*%%*+*+%+%+%+++