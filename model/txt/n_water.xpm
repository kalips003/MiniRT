"%+++++++++ +++++++%+++@+++++++++ %@++ + +%+%@ + + %+% + +++% + ++%+% % %% +@+++++%@++%++@++%  ++ % +++ +++% +++ +++++%++%++++ + + +++  +  + +++++++ O+ +++++O +O++O+  O+O +++ O+ +++OOO+O+OO +  O  ++O ++O+ O  ++ +++O+++ ++ O+++ O+ +++++++  + +++++ + %++ %%+%+  +%+ %%+ + +%++%+%  + %+++% ++ +%+ %%+%%+%@@%%++%+% % @% %+%%+++@ +%%+%++%%@%+% %%+@%  % @+% @@%% %% % % +@%%+ % @%% %+ %+% @%+%@+ %+ @%++@%++% +@%  %+ @+ % %  %% @% % %  ++ %  %+% +%% %@+@+% @%@@+@% + % +@ %  + +  %+ + % + @+ + +  + + % % + % ++ + + + +% + + +  + % + + + ++ +  + + + ++ + +  ++ +  + + +% + +  ++ +  + + + + + ++  + ++  + %  + ++++ % +   ++  +   ++ + +   +  ++ +  % +  +  ++ +  + +   + + + ++ +  + + + + + ++++  + ++  + +++  ++  +++ % ++ %+++ + ++%+ % +%+ + +% + ++%++%%+%%+%+++%%+ %+++++++++%+%+%%++%+%%++%%+%%++%%+++%++%+%++++++%:+++%+++++*+:++*+::++*+**%+**:*****+***+***+%==+**++O*+=+*+++*+OO+=%=+O+=*=+=O%++*==O+O*=++=**O**O=**O=:*+*++**+=+=+=**=****=**********:**************:*:::+*:+::++::++:+*+:+++:+++:**+:*:+:+::++::+*::+*%:+*::++:*:%+*:*::*+:+*:++:+****+*+*:+*:+*+*:%*+++*:+*:*%:+:+:++++:++%**+*%++*+*+*+++%**++++*+*%+%+++%+++++++%++++++++++++%++++++++++%+++%+%++++++%+++%++++++++%++%+++++++++++++*++++++%***++*+**++*+*++++:**:+**+++*:***:+*::++:*:*:*:::*::*:*::*::**::**<::*:<::*:*::::*<:*:<::*<:::::::;::;<:;::<:::::::<::;:<<::::;:<<:*<;:;*<::<<<:**:;;;;**<;*;;*;;;*;*;;;-**;;**;;;-*--*-*---*---*--------=-*=--=======:=========-========================-=--=-==========--$=====*=*=*=-*------*-----*-*--**-***--*-**-***-*-***********<***;***:***:*+:+*=%++++$+++++++$+++++ ++++ ++++++%%+% % @% + %+@  %%+ +% %%+% @% %%  %+@%+ %% %%%  +% +@%  % +% % +++% @% % @+% +% + %+ @ ++ + + + +++@ %++++++++++++%+++++++ ++++++++++++++++++++*+++++*++*+**++:*+*+*++*:+:*%*+*:+*+**+:******+**:+:%*%**:+:*::%:++:%**%**:%**:*%***%:%:%*:%*%*%*:%*%:::%*:::*::*::%%:%:%*%**%+:*::+::*%**::+::+**%**:*:*:*::++:*::++::**:**:*:*:+**+::****:**:******+*++*****:+***%:+**%*:+:+:***:+****:+**%**+***%%*++:*++*+:++++++++*+**%+*++*++++%*+*+++*