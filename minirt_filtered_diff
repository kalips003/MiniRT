// [1] C_find_colision.c — pointer iteration bug fix
// -------------------------------------------------
// - Changed initialization and iteration of object list pointers.

// Before:
    obj_ptr = data->objects - 1;
    while (++obj_ptr && *obj_ptr)

// After:
    obj_ptr = data->objects;
    while (obj_ptr && *obj_ptr)
        ...
    obj_ptr++;

// (Repeated in multiple loops)

// Meaning:
// - Fixes unsafe pointer pre-decrement pattern.
// - Ensures proper traversal of object array/list.


// [2] E0_lighting.c — light loop iteration fix
// ---------------------------------------------
// Before:
    lights = data->light - 1;
    while (++lights && *lights)

// After:
    lights = data->light;
    while (lights && *lights)
        ...
    lights++;

// Meaning:
// - Fixes off-by-one / sentinel iteration bug.
// - Ensures correct traversal of light array.


// [3] E0_lighting_simple.c — same loop fix
// ----------------------------------------
// Before:
    lights = data->light - 1;
    while (++lights && *lights)

// After:
    lights = data->light;
    while (lights && *lights)
        lights++;

// Meaning:
// - Consistency fix with main lighting loop.


// [4] D9_dist_objects.c — texture coordinate correction
// ------------------------------------------------------
// Before:
    normal_map = return_vect_img(obj->param.n_map, c->u, c->v);

// After:
    normal_map = return_vect_img(obj->param.n_map, c->u, 1.0 - c->v);

// Meaning:
// - Fixes vertical UV mapping (texture flip on V axis).
// - This is a real visual correction.


